# MiMo-FinRobot 环境变量配置

# 应用配置
APP_NAME=MiMo-FinRobot
APP_VERSION=0.1.0
DEBUG=false

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./mimo_finrobot.db

# MiMo API 配置
MIMO_API_KEY=your_mimo_api_key_here
MIMO_API_BASE_URL=https://api.mimo.com/v1
MIMO_MODEL_PRO=MiMo-V2.5-Pro
MIMO_MODEL_OMNI=MiMo-V2.5-Omni
MIMO_MODEL_TTS=MiMo-V2.5-TTS

# Token 限制
MAX_TOKENS_PRO=4096
MAX_TOKENS_OMNI=2048
MAX_TOKENS_TTS=1024

# 速率限制（每分钟请求数）
RATE_LIMIT_PRO=10
RATE_LIMIT_OMNI=5
RATE_LIMIT_TTS=10
